# CataLogA — redshift catastrophe detection agent
# 复制为 .env 后填入实际值

# ── LLM ──
# 必填：API 密钥
LLM_API_KEY=
# API 地址：留空使用官方 API（DeepSeek 走 OpenAI 兼容，Anthropic 原生调用）
# DeepSeek 示例：https://api.deepseek.com
LLM_BASE_URL=
# 模型名称：deepseek-v4-pro（DeepSeek）| claude-opus-5（Anthropic，模型名以 claude 开头自动走原生 API）
LLM_MODEL=claude-opus-5
# 按 stage 覆盖模型（留空 = 用 LLM_MODEL）。推荐：SH/FA 用 claude-sonnet-5，
# HS/RA 保持 claude-opus-5 —— SH/FA 是规则化的工具调用任务（对预测谱线逐条验证 /
# 审计），Sonnet 5 已能胜任；HS/RA 是开放式综合判断和成因诊断，用 Opus 5 保证质量。
# 经 4 个目标的 A/B 测试验证：3/4 verdict 完全不变，唯一变化的 1 个案例本身在纯
# Opus 5 下 HS/RA 就已经意见分裂（非确定性判决），换用 Sonnet 5 后两者转为一致的
# INDETERMINATE。已知答案的 flagship 案例（39628250216924756）两种配置下都正确
# 给出 PREFER_H2。平均额外节省成本约 40%（在 prompt caching 基础上）。
LLM_MODEL_SH=claude-sonnet-5
LLM_MODEL_FA=claude-sonnet-5
LLM_MODEL_HS=
LLM_MODEL_RA=
# 采样温度
LLM_TEMPERATURE=0.1
# 最大输出 token（留空 = DeepSeek 自动用 65536）
LLM_MAX_TOKENS=
# 思维链模式：enabled | disabled
# - disabled：默认。简单调用无推理过程；工具调用（redrock 模式）始终 disabled
# - enabled：简单 LLM 调用时显示模型推理链（thinking 内容）
LLM_THINKING=disabled
# ReAct 过程实时输出：true | false
# - true：工具调用模式时，实时打印每一轮 LLM 调了哪个工具、返回了什么
# - false：默认，静默执行
LLM_STREAMING=false

# ── Agent 递归上限 ──
MAX_TURNS_SH=500
MAX_TURNS_FA=500
MAX_TURNS_HS=500
MAX_TURNS_RA=500

# ── 阶段级重试（SH/FA/HS/RA）──
# 任一 LLM 阶段失败后的重试次数；全部失败则该 target 失败，不进入下游
STAGE_RETRIES=3
# 重试间隔（秒）
STAGE_RETRY_DELAY=60

# ── CWT 特征检测 ──
# 信噪比阈值（越大越严格）
CWT_SNR_THRESH=8.0
# 最小脊线长度（特征需在多少尺度上被检测才算有效）
CWT_MIN_RIDGE_LENGTH=4
# 小波尺度数量（对数均匀分布）
CWT_N_SCALES=24
# 检测的最窄谱线宽度（≈ FWHM / 2.355 px）
CWT_MIN_WIDTH=1.0
# 检测的最宽谱线宽度（≈ FWHM / 2.355 px）
CWT_MAX_WIDTH=80.0

# ── 预处理 ──
# DESI 原始数据根目录
DATA_ROOT=.data/test_catas
# 中间目录（preprocess.py 在此创建 targetid 子目录 + symlink）
INTERMEDIATE_DIR=input
# 流水线输出目录（每 TARGETID 一个子目录）
OUTPUT_DIR=output
# 红移差阈值（tracer-dependent，fractional |Δz| = |z1-z2|/(1+z_mean)）：
# 只有 |Δz| >= 对应阈值的目标才会生成 symlink。Redrock 不给出 BGS/LRG/ELG 分类，
# 只有拟合出的 SPECTYPE，故按 RedrockType 是否为 QSO 二选一阈值。
# QSO（宽线，红移精度低）：0.03 ≈ dv 10,000 km/s
DZ_THRESHOLD_QSO=0.03
# 星系类（窄线，红移精度高）：0.003 ≈ dv 1,000 km/s
DZ_THRESHOLD_GALAXY=0.003

# ── 流水线目标 ──
# 单个 ID、逗号分隔、all、tail-5、head-10、[10:]、[:30]、[8:10,17:50]
TARGETID=39628250216924756