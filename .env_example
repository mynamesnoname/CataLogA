# CataLogA — redshift catastrophe detection agent
# 复制为 .env 后填入实际值

# ── LLM ──
# 必填：API 密钥
LLM_API_KEY=
# API 地址（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com
# 模型名称
LLM_MODEL=deepseek-v4-pro
# 采样温度
LLM_TEMPERATURE=0.1
# 最大输出 token（留空 = DeepSeek 自动用 65536）
LLM_MAX_TOKENS=
# 思维链模式：enabled | disabled
# - disabled：默认。简单调用无推理过程；工具调用（redrock 模式）始终 disabled
# - enabled：简单 LLM 调用时显示模型推理链（thinking 内容）
LLM_THINKING=disabled
# ReAct 过程实时输出：true | false
# - true：工具调用模式时，实时打印每一轮 LLM 调了哪个工具、返回了什么
# - false：默认，静默执行
LLM_STREAMING=false

# ── CWT 特征检测 ──
# 信噪比阈值（越大越严格）
CWT_SNR_THRESH=8.0
# 最小脊线长度（特征需在多少尺度上被检测才算有效）
CWT_MIN_RIDGE_LENGTH=4
# 小波尺度数量（对数均匀分布）
CWT_N_SCALES=24
# 检测的最窄谱线宽度（≈ FWHM / 2.355 px）
CWT_MIN_WIDTH=1.0
# 检测的最宽谱线宽度（≈ FWHM / 2.355 px）
CWT_MAX_WIDTH=80.0

# ── 数据路径 ──
# DESI 原始数据根目录（用于制备 input/ 目录）
DATA_ROOT=.data/test_catas
# 流水线输入目录（按 TARGETID 组织，每目录 4 个 FITS）
INPUT_DIR=input
# 流水线输出目录（每 TARGETID 一个子目录）
OUTPUT_DIR=output

# ── 流水线目标 ──
# 要处理的目标：单个 ID、逗号分隔列表、或 "all"
TARGETID=39628250216924756